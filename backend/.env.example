# SafeWalk SF Backend Configuration

# Anthropic API Key (optional - enables AI-powered natural language queries)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SF Open Data App Token (optional - higher rate limits)
SF_APP_TOKEN=your_sf_opendata_token_here

# Snow Leopard API (required for real incident database queries)
SNOWLEOPARD_API_KEY=your_snowleopard_api_key_here
SNOWLEOPARD_DATAFILE_ID=your_snowleopard_datafile_id_here
